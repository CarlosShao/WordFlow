# =============================================================================
# WordFlow Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in all values.
# DO NOT commit .env.production to version control.
# =============================================================================

# -- Application --
DOMAIN=your-domain.com
API_VERSION=latest
NODE_ENV=production

# -- Server --
PORT=3001
LOG_LEVEL=info

# -- PostgreSQL Database --
POSTGRES_USER=wordflow
POSTGRES_PASSWORD=
# GENERATE: openssl rand -base64 48
POSTGRES_DB=wordflow
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# -- Redis --
REDIS_PASSWORD=
# GENERATE: openssl rand -base64 32
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# -- MinIO Object Storage --
MINIO_ACCESS_KEY=
# GENERATE: openssl rand -base64 24 (min 8 chars)
MINIO_SECRET_KEY=
# GENERATE: openssl rand -base64 48 (min 8 chars)
MINIO_BUCKET=wordflow
MINIO_PORT=9000
MINIO_USE_SSL=false

# -- JWT Authentication --
# CRITICAL: Use long random strings (min 32 chars)
JWT_SECRET=
# GENERATE: openssl rand -hex 64
JWT_REFRESH_SECRET=
# GENERATE: openssl rand -hex 64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -- GitHub OAuth (optional) --
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=https://${DOMAIN}/api/v1/auth/github/callback

# -- CORS --
CORS_ORIGIN=https://${DOMAIN}

# -- AI / LLM (OpenAI-compatible) --
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
# Get from: https://platform.deepseek.com/api_keys
AI_MODEL=deepseek-chat

# -- External API Keys (optional) --
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
